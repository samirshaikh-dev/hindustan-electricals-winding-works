  <!-- JSON-LD Structured Data: FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What types of motors do you rewind?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We rewind single-phase and 3-phase AC induction motors, DC motors, armatures, generator alternators, transformer coils, and industrial pump motors."
        }
      },
      {
        "@type": "Question",
        "name": "Do you handle AC and DC motors?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, we provide complete rewinding, stator insulation, armature overhaul, commutator undercutting, and brush alignment for both AC and DC equipment."
        }
      },
      {
        "@type": "Question",
        "name": "How long does rewinding take?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Turnaround depends on the motor rating, core condition, copper requirements, and current workshop workload. We prioritize emergency factory breakdowns to minimize plant downtime."
        }
      },
      {
        "@type": "Question",
        "name": "How is rewinding cost calculated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cost is determined by motor horsepower/kW rating, frame size, weight of electrolytic copper wire, insulation grade (Class F or H), and any mechanical work such as bearing replacement. We inspect the motor and provide a clear quotation before beginning work."
        }
      },
      {
        "@type": "Question",
        "name": "Do you provide motor testing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Every repaired motor undergoes pre-delivery testing including Megger insulation resistance testing, winding resistance balance, and no-load current checks."
        }
      },
      {
        "@type": "Question",
        "name": "Where is the workshop located?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Shop No. 28 & 29, Express House, Near C.N.G. Gujarat Gas Station, N.H. 48, GIDC, Vapi, Gujarat 396195, with direct national highway access for trucks and transport."
        }
      }
    ]
  }
  </script>
